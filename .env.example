# ─────────────────────────────────────────────────────────────
# GASFlow — environment variables template
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Database ────────────────────────────────────────────────
# Runtime role — no ownership, no BYPASSRLS, RLS enforced.
DATABASE_URL_APP=postgres://gasflow_app:CHANGE_ME_APP@localhost:5432/gasflow
# Migration / owner role — used only by the migration runner.
DATABASE_URL_OWNER=postgres://gasflow_owner:CHANGE_ME_OWNER@localhost:5432/gasflow

# Bootstrap superuser for the Postgres container (compose only)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER
POSTGRES_DB=gasflow

# ─── Sessions ────────────────────────────────────────────────
SESSION_COOKIE_NAME=gasflow_sid
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
SESSION_TTL_DAYS=14
CSRF_COOKIE_NAME=gasflow_csrf

# ─── Argon2id ────────────────────────────────────────────────
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# ─── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SEC=900
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_RESET_WINDOW_SEC=3600

# ─── Email (Phase 1: dev stub only) ──────────────────────────
EMAIL_DRIVER=console
EMAIL_FROM=no-reply@gasflow.local

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
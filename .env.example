# ─────────────────────────────────────────────────────────────
# GASFlow — Environment Variables Template
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Database ────────────────────────────────────────────────
# Runtime role (gasflow_app) — RLS enforced, restricted access.
DATABASE_URL_APP=postgres://gasflow_app:CHANGE_ME_APP_PASSWORD@localhost:5432/gasflow

# Migration role (gasflow_owner) — Used only for migrations and Prisma.
DATABASE_URL_OWNER=postgres://gasflow_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/gasflow

# Role passwords for first-init.
# Consistency: GASFLOW_APP_PASSWORD == password in DATABASE_URL_APP
#              GASFLOW_OWNER_PASSWORD == password in DATABASE_URL_OWNER
GASFLOW_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
GASFLOW_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD

# Bootstrap superuser (compose only; the app NEVER connects as this)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD
POSTGRES_DB=gasflow

# ─── Sessions ────────────────────────────────────────────────
SESSION_COOKIE_NAME=gasflow_sid
# Generate a random 32-byte string (e.g., openssl rand -base64 48)
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
SESSION_TTL_DAYS=14
CSRF_COOKIE_NAME=gasflow_csrf

# ─── Argon2id ────────────────────────────────────────────────
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# ─── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SEC=900
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_RESET_WINDOW_SEC=3600

# ─── Email (Phase 1: dev stub only) ──────────────────────────
EMAIL_DRIVER=console
EMAIL_FROM=no-reply@gasflow.local

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info